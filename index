// ─── 구글 API 초기화 ───────────────────────────────────────
function initGoogleAuth() {
  if (!window.google || GOOGLE_CLIENT_ID === 'YOUR_GOOGLE_CLIENT_ID_HERE') {
    updateAuthUI('disconnected');
    return;
  }
  tokenClient = google.accounts.oauth2.initTokenClient({
    client_id: GOOGLE_CLIENT_ID,
    scope: 'https://www.googleapis.com/auth/drive.file',
    callback: (response) => {
      if (response.error) {
        showToast('⚠️ 구글 로그인 실패: ' + response.error);
        updateAuthUI('disconnected');
        return;
      }
      gauthAccessToken = response.access_token;
      updateAuthUI('connected');
      showToast('✅ 구글 드라이브 연결 완료!');
    },
  });
  updateAuthUI('disconnected');
}

function handleAuthClick() {
  if (gauthAccessToken) {
    // 로그아웃
    google.accounts.oauth2.revoke(gauthAccessToken, () => {
      gauthAccessToken = null;
      updateAuthUI('disconnected');
      showToast('구글 연결이 해제되었습니다.');
    });
  } else {
    if (!tokenClient) { showToast('Google Client ID를 먼저 설정해주세요.'); return; }
    tokenClient.requestAccessToken();
    updateAuthUI('connecting');
  }
}

function updateAuthUI(state) {
  const dot = document.getElementById('gauthDot');
  const label = document.getElementById('gauthLabel');
  const notice = document.getElementById('gauthNotice');
  dot.className = 'gauth-dot';
  if (state === 'connected') {
    dot.classList.add('connected');
    label.textContent = '구글 연결됨 ✓';
    if (notice) notice.style.display = 'none';
  } else if (state === 'connecting') {
    dot.classList.add('connecting');
    label.textContent = '연결 중...';
  } else {
    label.textContent = '구글 연결';
    if (notice) notice.style.display = 'flex';
  }
}

// ─── 구글 드라이브 파일 업로드 ─────────────────────────────
async function uploadToDrive(file, dept) {
  if (!gauthAccessToken) throw new Error('구글 로그인이 필요합니다.');

  const folderId = DEPT_FOLDER_IDS[dept];
  if (!folderId || folderId.startsWith('FOLDER_ID_')) {
    throw new Error(`"${dept}" 폴더 ID가 설정되지 않았습니다.`);
  }

  // 진행 UI 표시
  const wrap = document.getElementById('uploadProgressWrap');
  const bar = document.getElementById('uploadProgressBar');
  const pct = document.getElementById('uploadProgressPct');
  const fname = document.getElementById('uploadProgressFileName');
  wrap.classList.add('show');
  fname.textContent = file.name;
  bar.style.width = '5%';
  pct.textContent = '준비 중...';

  // 1단계: multipart 업로드 (메타데이터 + 파일)
  const metadata = {
    name: file.name,
    mimeType: file.type || 'application/octet-stream',
    parents: [folderId]
  };

  const form = new FormData();
  form.append('metadata', new Blob([JSON.stringify(metadata)], { type: 'application/json' }));
  form.append('file', file);

  bar.style.width = '30%';
  pct.textContent = '업로드 중...';

  // XMLHttpRequest로 진행률 표시
  const driveFileId = await new Promise((resolve, reject) => {
    const xhr = new XMLHttpRequest();
    xhr.open('POST', 'https://www.googleapis.com/upload/drive/v3/files?uploadType=multipart&fields=id,name,webViewLink');
    xhr.setRequestHeader('Authorization', 'Bearer ' + gauthAccessToken);
    xhr.upload.onprogress = (e) => {
      if (e.lengthComputable) {
        const p = Math.round((e.loaded / e.total) * 60) + 30;
        bar.style.width = p + '%';
        pct.textContent = Math.round((e.loaded / e.total) * 100) + '%';
      }
    };
    xhr.onload = () => {
      if (xhr.status === 200) {
        const res = JSON.parse(xhr.responseText);
        resolve(res.id);
      } else {
        reject(new Error('업로드 실패: ' + xhr.status + ' ' + xhr.responseText));
      }
    };
    xhr.onerror = () => reject(new Error('네트워크 오류'));
    xhr.send(form);
  });

  bar.style.width = '85%';
  pct.textContent = '공유 설정 중...';

  // 2단계: 파일 공유 권한 설정 (링크 있는 모든 사용자 읽기)
  await fetch(`https://www.googleapis.com/drive/v3/files/${driveFileId}/permissions`, {
    method: 'POST',
    headers: {
      'Authorization': 'Bearer ' + gauthAccessToken,
      'Content-Type': 'application/json'
    },
    body: JSON.stringify({ role: 'reader', type: 'anyone' })
  });

  bar.style.width = '100%';
  pct.textContent = '완료!';

  const viewUrl = `https://drive.google.com/file/d/${driveFileId}/view?usp=sharing`;
  const downloadUrl = `https://drive.google.com/uc?export=download&id=${driveFileId}`;

  setTimeout(() => wrap.classList.remove('show'), 1200);

  return { url: viewUrl, downloadUrl, name: file.name, driveId: driveFileId };
}

// ─── 파일 선택 핸들러 ──────────────────────────────────────
function handleFileSelect(file) {
  if (!file) return;
  if (!gauthAccessToken) {
    document.getElementById('gauthNotice').style.display = 'flex';
    document.getElementById('fileInput').value = '';
    showToast('⚠️ 먼저 구글 계정을 연결해주세요!');
    return;
  }
  selectedFile = file;
  uploadedFileInfo = null;
  const af = document.getElementById('attachedFile');
  document.getElementById('attachedFileName').textContent = file.name;
  document.getElementById('attachedFileSize').textContent = formatBytes(file.size);
  af.classList.add('show');
  document.getElementById('existingFileInfo').style.display = 'none';
}

function removeAttachedFile() {
  selectedFile = null;
  uploadedFileInfo = null;
  document.getElementById('fileInput').value = '';
  document.getElementById('attachedFile').classList.remove('show');
  document.getElementById('uploadProgressWrap').classList.remove('show');
}

function formatBytes(bytes) {
  if (bytes < 1024) return bytes + ' B';
  if (bytes < 1024*1024) return (bytes/1024).toFixed(1) + ' KB';
  return (bytes/1024/1024).toFixed(1) + ' MB';
}

// 드래그 앤 드롭
const uploadZone = document.getElementById('uploadZone');
uploadZone.addEventListener('dragover', e => { e.preventDefault(); uploadZone.classList.add('dragover'); });
uploadZone.addEventListener('dragleave', () => uploadZone.classList.remove('dragover'));
uploadZone.addEventListener('drop', e => {
  e.preventDefault();
  uploadZone.classList.remove('dragover');
  const f = e.dataTransfer.files[0];
  if (f) handleFileSelect(f);
});

// ─── Supabase 초기화 ───────────────────────────────────────
async function init() {
  await loadPosts();
  buildTabs();
  // GIS 로드 후 초기화
  if (window.google && window.google.accounts) {
    initGoogleAuth();
  } else {
    document.getElementById('gsi').onload = initGoogleAuth;
  }
}

async function loadPosts() {
  const { data, error } = await db.from('posts').select('*').order('created_at', { ascending: false });
  if (error) { console.warn(error.message); allPosts = []; }
  else allPosts = data || [];
  renderAll(); updateTabCounts();
}

// ─── 렌더링 ────────────────────────────────────────────────
function renderAll() {
  const grid = document.getElementById('columnsGrid');
  const depts = currentDept === 'all' ? DEPTS : [currentDept];
  const filtered = getFiltered();
  grid.innerHTML = '';
  depts.forEach(dept => {
    const posts = filtered.filter(p => p.dept === dept);
    const col = document.createElement('div');
    col.className = 'column-card';
    col.innerHTML = `
      <div class="col-header">
        <div class="col-name">
          <span class="col-dot" style="background:${DEPT_COLORS[dept]||'#52b788'}"></span>${dept}
        </div>
      </div>
      <div class="col-body">
        ${posts.length === 0
          ? `<div class="empty-state"><div class="empty-state-icon">📂</div><div class="empty-state-text">게시물 없음</div></div>`
          : posts.map(p => postCardHTML(p)).join('')}
      </div>
      <button class="col-add-btn" onclick="openPostModal('${dept}')">＋ 게시물 추가</button>`;
    grid.appendChild(col);
  });
  document.getElementById('totalCountLabel').textContent = `총 ${filtered.length}개 게시물`;
}

function postCardHTML(p) {
  const color = DEPT_COLORS[p.dept] || '#52b788';
  return `<div class="post-card" onclick="viewPost('${p.id}')">
    <div class="post-card-author">
      <div class="post-avatar" style="background:${color}">${(p.author||'?')[0]}</div>
      <span class="post-author-name">${esc(p.author)}</span>
      <span class="post-time">${fmtTime(p.created_at)}</span>
    </div>
    <div class="post-title">${esc(p.title)}</div>
    ${p.body ? `<div class="post-body">${esc(p.body)}</div>` : ''}
    ${p.file_url ? `<div class="post-file-badge">📁 ${esc(p.file_name||'파일')}</div>` : ''}
  </div>`;
}

function getFiltered() {
  let posts = allPosts;
  if (currentDept !== 'all') posts = posts.filter(p => p.dept === currentDept);
  if (searchQuery) {
    const q = searchQuery.toLowerCase();
    posts = posts.filter(p =>
      (p.title||'').toLowerCase().includes(q) ||
      (p.body||'').toLowerCase().includes(q) ||
      (p.author||'').toLowerCase().includes(q)
    );
  }
  return posts;
}

function buildTabs() {
  const bar = document.getElementById('tabsBar');
  bar.querySelectorAll('[data-dept]:not([data-dept="all"])').forEach(e => e.remove());
  DEPTS.forEach(dept => {
    const btn = document.createElement('button');
    btn.className = 'tab-btn'; btn.dataset.dept = dept;
    btn.innerHTML = `${dept} <span class="tab-count" id="count-${dept}">0</span>`;
    btn.onclick = () => filterDept(dept, btn);
    bar.appendChild(btn);
  });
  updateTabCounts();
}

function updateTabCounts() {
  const el = document.getElementById('count-all');
  if (el) el.textContent = allPosts.length;
  DEPTS.forEach(dept => {
    const e = document.getElementById(`count-${dept}`);
    if (e) e.textContent = allPosts.filter(p => p.dept === dept).length;
  });
}

function filterDept(dept, btn) {
  currentDept = dept;
  document.querySelectorAll('.tab-btn').forEach(b => b.classList.remove('active'));
  btn.classList.add('active');
  document.getElementById('currentDeptLabel').textContent = dept === 'all' ? '전체 부서' : dept;
  renderAll();
}

function filterPosts() { searchQuery = document.getElementById('searchInput').value.trim(); renderAll(); }

// ─── 게시물 보기 ────────────────────────────────────────────
function viewPost(id) {
  const p = allPosts.find(x => x.id === id); if (!p) return;
  viewingPostId = id;
  const color = DEPT_COLORS[p.dept] || '#52b788';
  let fileHTML = '';
  if (p.file_url) {
    fileHTML = `
      <a class="view-file-link" href="${p.file_url}" target="_blank">📁 ${esc(p.file_name||'파일')} 열기</a>
      ${p.file_download_url
        ? `<a class="view-file-download" href="${p.file_download_url}" download="${esc(p.file_name||'파일')}">⬇️ 다운로드</a>`
        : ''}`;
  }
  document.getElementById('viewContent').innerHTML = `
    <div class="view-meta">
      <span class="view-dept-tag" style="background:${color}">${p.dept}</span>
      <span class="view-author">${esc(p.author)}</span>
      <span class="view-time">${fmtTime(p.created_at)}</span>
    </div>
    <div class="view-title">${esc(p.title)}</div>
    <div class="view-body">${esc(p.body||'')}</div>
    ${fileHTML}`;
  document.getElementById('viewModal').classList.add('open');
}
function closeViewModal() { document.getElementById('viewModal').classList.remove('open'); viewingPostId = null; }

// ─── 게시물 편집/작성 모달 ──────────────────────────────────
function openEditFromView() {
  const p = allPosts.find(x => x.id === viewingPostId); if (!p) return;
  closeViewModal(); openPostModal(null, p);
}

function openPostModal(dept, editPost) {
  resetForm();
  const notice = document.getElementById('gauthNotice');
  notice.style.display = gauthAccessToken ? 'none' : 'flex';

  if (editPost) {
    document.getElementById('postModalTitle').textContent = '✏️ 게시물 수정';
    document.getElementById('postSubmitBtn').textContent = '저장하기';
    document.getElementById('editPostId').value = editPost.id;
    document.getElementById('postDept').value = editPost.dept;
    document.getElementById('postAuthor').value = editPost.author;
    document.getElementById('postTitle').value = editPost.title;
    document.getElementById('postBody').value = editPost.body || '';
    if (editPost.file_url) {
      const info = document.getElementById('existingFileInfo');
      const link = document.getElementById('existingFileLink');
      link.href = editPost.file_url;
      link.textContent = editPost.file_name || '첨부파일';
      info.style.display = 'block';
    }
  } else {
    document.getElementById('postModalTitle').textContent = '📋 새 게시물 작성';
    document.getElementById('postSubmitBtn').textContent = '게시하기';
    if (dept) document.getElementById('postDept').value = dept;
  }
  document.getElementById('postModal').classList.add('open');
}

function closePostModal() { document.getElementById('postModal').classList.remove('open'); resetForm(); }

function resetForm() {
  ['editPostId','postAuthor','postTitle','postBody'].forEach(id => document.getElementById(id).value = '');
  document.getElementById('postDept').value = '';
  document.getElementById('fileInput').value = '';
  document.getElementById('attachedFile').classList.remove('show');
  document.getElementById('uploadProgressWrap').classList.remove('show');
  document.getElementById('existingFileInfo').style.display = 'none';
  selectedFile = null;
  uploadedFileInfo = null;
}

// ─── 게시물 저장 ────────────────────────────────────────────
async function submitPost() {
  const editId  = document.getElementById('editPostId').value;
  const dept    = document.getElementById('postDept').value.trim();
  const author  = document.getElementById('postAuthor').value.trim();
  const title   = document.getElementById('postTitle').value.trim();
  const body    = document.getElementById('postBody').value.trim();
  if (!dept || !author || !title) { showToast('부서, 작성자, 제목은 필수입니다.'); return; }

  const btn = document.getElementById('postSubmitBtn');
  btn.disabled = true; btn.textContent = '처리 중...';

  try {
    let fileUrl = null, fileDownloadUrl = null, fileName = null;

    // 새 파일이 선택된 경우 Drive 업로드
    if (selectedFile) {
      if (!gauthAccessToken) { showToast('⚠️ 구글 계정을 먼저 연결해주세요!'); return; }
      showToast('📤 구글 드라이브에 업로드 중...');
      const info = await uploadToDrive(selectedFile, dept);
      fileUrl = info.url;
      fileDownloadUrl = info.downloadUrl;
      fileName = info.name;
    }

    if (editId) {
      const upd = { dept, author, title, body };
      if (fileUrl) { upd.file_url = fileUrl; upd.file_download_url = fileDownloadUrl; upd.file_name = fileName; }
      const { data, error } = await db.from('posts').update(upd).eq('id', editId).select();
      if (error) throw error;
      allPosts = allPosts.map(p => p.id === editId ? data[0] : p);
      showToast('✅ 게시물이 수정되었습니다!');
    } else {
      const { data, error } = await db.from('posts').insert([{ dept, author, title, body, file_url: fileUrl, file_download_url: fileDownloadUrl, file_name: fileName }]).select();
      if (error) throw error;
      allPosts = [data[0], ...allPosts];
      showToast('✅ 게시물이 등록되었습니다!');
    }
    closePostModal(); renderAll(); updateTabCounts();
  } catch(e) {
    showToast('오류: ' + e.message);
    console.error(e);
  } finally {
    btn.disabled = false;
    btn.textContent = document.getElementById('editPostId').value ? '저장하기' : '게시하기';
  }
}

// ─── 삭제 ───────────────────────────────────────────────────
function confirmDelete() { document.getElementById('confirmModal').classList.add('open'); }
function closeConfirmModal() { document.getElementById('confirmModal').classList.remove('open'); }

async function deletePost() {
  if (!viewingPostId) return;
  const { error } = await db.from('posts').delete().eq('id', viewingPostId);
  if (error) { showToast('삭제 오류: ' + error.message); return; }
  allPosts = allPosts.filter(x => x.id !== viewingPostId);
  closeConfirmModal(); closeViewModal(); renderAll(); updateTabCounts();
  showToast('🗑️ 게시물이 삭제되었습니다. (드라이브 파일은 별도 삭제)');
}

// ─── 유틸 ───────────────────────────────────────────────────
function fmtTime(iso) {
  if (!iso) return '';
  const diff = (Date.now() - new Date(iso)) / 1000;
  if (diff < 60) return '방금 전';
  if (diff < 3600) return Math.floor(diff/60) + '분 전';
  if (diff < 86400) return Math.floor(diff/3600) + '시간 전';
  const d = new Date(iso); return `${d.getMonth()+1}/${d.getDate()}`;
}
function esc(str) { return (str||'').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;'); }
function showToast(msg) {
  const t = document.getElementById('toast');
  t.textContent = msg; t.classList.add('show');
  setTimeout(() => t.classList.remove('show'), 3500);
}

document.getElementById('postModal').addEventListener('click', function(e) { if (e.target === this) closePostModal(); });
document.getElementById('viewModal').addEventListener('click', function(e) { if (e.target === this) closeViewModal(); });
document.getElementById('confirmModal').addEventListener('click', function(e) { if (e.target === this) closeConfirmModal(); });

// GIS 스크립트 로드 확인 후 초기화
window.addEventListener('load', () => {
  init();
  setTimeout(() => { if (window.google) initGoogleAuth(); }, 800);
});
</script>

