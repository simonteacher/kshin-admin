<!DOCTYPE html>
<html lang="ko">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>광주경신여자고등학교 - 2026 행정자료 공유</title>
  <link href="https://fonts.googleapis.com/css2?family=Noto+Sans+KR:wght@300;400;500;700;900&family=Gowun+Batang:wght@400;700&display=swap" rel="stylesheet">
  <script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>

  <!-- ✅ Google API 클라이언트 라이브러리 -->
  <script src="https://apis.google.com/js/api.js"></script>
  <script src="https://accounts.google.com/gsi/client"></script>

  <style>
    :root {
      --bg:#f0f4f0; --surface:#fff; --surface2:#e8f0e8; --border:#c8d8c8;
      --primary:#2d6a4f; --primary-light:#52b788; --primary-dark:#1b4332;
      --accent:#f4a261; --accent2:#e76f51; --danger:#e63946;
      --text:#1a2e1a; --text-muted:#5a7a5a;
      --shadow:0 4px 24px rgba(45,106,79,0.10); --shadow-hover:0 8px 32px rgba(45,106,79,0.18);
      --radius:16px; --radius-sm:10px;
    }
    *{box-sizing:border-box;margin:0;padding:0}
    body{font-family:'Noto Sans KR',sans-serif;background:var(--bg);color:var(--text);min-height:100vh;overflow-x:hidden}

    header{background:var(--primary-dark);color:#fff;padding:0 32px;display:flex;align-items:center;justify-content:space-between;height:64px;position:sticky;top:0;z-index:100;box-shadow:0 2px 16px rgba(0,0,0,0.18)}
    .header-left{display:flex;align-items:center;gap:14px}
    .school-logo{width:38px;height:38px;background:var(--primary-light);border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:18px;font-weight:900;color:#fff;flex-shrink:0}
    .header-school{font-family:'Gowun Batang',serif;font-size:15px;font-weight:700;letter-spacing:1px;color:#d8f3dc}
    .header-sub{font-size:11px;color:#95d5b2}
    .header-actions{display:flex;gap:10px;align-items:center}

    /* 구글 로그인 상태 표시 */
    .gauth-status{display:flex;align-items:center;gap:8px;background:rgba(255,255,255,0.10);border-radius:20px;padding:5px 12px;font-size:12px;cursor:pointer;border:1.5px solid rgba(255,255,255,0.2);transition:all 0.18s}
    .gauth-status:hover{background:rgba(255,255,255,0.18)}
    .gauth-dot{width:8px;height:8px;border-radius:50%;background:#aaa;flex-shrink:0}
    .gauth-dot.connected{background:#52b788;box-shadow:0 0 0 2px rgba(82,183,136,0.3)}
    .gauth-dot.connecting{background:#f4a261;animation:pulse 1s infinite}
    @keyframes pulse{0%,100%{opacity:1}50%{opacity:0.4}}
    .gauth-label{color:#d8f3dc;white-space:nowrap}

    .btn{display:inline-flex;align-items:center;gap:6px;padding:8px 18px;border-radius:8px;font-family:'Noto Sans KR',sans-serif;font-size:13px;font-weight:500;cursor:pointer;border:none;transition:all 0.18s}
    .btn-primary{background:var(--primary-light);color:#fff}
    .btn-primary:hover{background:var(--accent);transform:translateY(-1px)}
    .btn-primary:disabled{background:#aaa;cursor:not-allowed;transform:none}
    .btn-danger{background:var(--danger);color:#fff}
    .btn-danger:hover{background:#c1121f}
    .btn-edit{background:#f0f4f0;color:var(--primary-dark);border:1.5px solid var(--border)}
    .btn-edit:hover{background:var(--surface2)}
    .btn-cancel{background:var(--surface2);color:var(--text-muted);border:1.5px solid var(--border)}
    .btn-cancel:hover{background:var(--border)}

    .tabs-bar{background:var(--primary);display:flex;align-items:center;padding:0 32px;overflow-x:auto;gap:2px;min-height:48px}
    .tabs-bar::-webkit-scrollbar{height:3px}
    .tabs-bar::-webkit-scrollbar-thumb{background:var(--primary-light);border-radius:2px}
    .tab-btn{background:none;border:none;cursor:pointer;color:#b7e4c7;font-family:'Noto Sans KR',sans-serif;font-size:13px;font-weight:500;padding:12px 20px;white-space:nowrap;border-bottom:3px solid transparent;transition:all 0.18s}
    .tab-btn:hover{color:#fff;background:rgba(255,255,255,0.08)}
    .tab-btn.active{color:#fff;font-weight:700;border-bottom-color:var(--accent);background:rgba(255,255,255,0.10)}
    .tab-count{display:inline-block;background:var(--accent);color:#fff;font-size:10px;font-weight:700;border-radius:10px;padding:1px 7px;margin-left:4px}

    .board-wrapper{padding:24px 32px 80px}
    .board-header{display:flex;align-items:center;justify-content:space-between;margin-bottom:20px}
    .board-title-row{display:flex;align-items:center;gap:10px}
    .dept-badge{font-size:11px;background:var(--primary-light);color:#fff;padding:3px 10px;border-radius:20px;font-weight:600}
    .dept-label{font-family:'Gowun Batang',serif;font-size:20px;font-weight:700;color:var(--primary-dark)}
    .columns-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(280px,1fr));gap:18px}
    .column-card{background:var(--surface);border-radius:var(--radius);border:1.5px solid var(--border);display:flex;flex-direction:column;min-height:220px;box-shadow:var(--shadow);transition:box-shadow 0.2s}
    .column-card:hover{box-shadow:var(--shadow-hover)}
    .col-header{display:flex;align-items:center;justify-content:space-between;padding:14px 16px 12px;border-bottom:1px solid var(--border);background:var(--surface2);border-radius:var(--radius) var(--radius) 0 0}
    .col-name{font-weight:700;font-size:14px;color:var(--primary-dark);display:flex;align-items:center;gap:6px}
    .col-dot{width:8px;height:8px;border-radius:50%;flex-shrink:0}
    .col-body{flex:1;padding:10px;display:flex;flex-direction:column;gap:8px;overflow-y:auto;max-height:420px}
    .col-body::-webkit-scrollbar{width:4px}
    .col-body::-webkit-scrollbar-thumb{background:var(--border);border-radius:2px}
    .col-add-btn{margin:8px 10px 10px;background:none;border:1.5px dashed var(--border);border-radius:var(--radius-sm);color:var(--text-muted);font-size:13px;padding:8px;cursor:pointer;transition:all 0.18s;font-family:'Noto Sans KR',sans-serif}
    .col-add-btn:hover{border-color:var(--primary-light);color:var(--primary);background:var(--surface2)}

    .post-card{background:var(--surface);border:1px solid var(--border);border-radius:var(--radius-sm);padding:12px;cursor:pointer;transition:all 0.18s;box-shadow:0 1px 6px rgba(45,106,79,0.06)}
    .post-card:hover{border-color:var(--primary-light);box-shadow:0 4px 16px rgba(45,106,79,0.14);transform:translateY(-1px)}
    .post-card-author{display:flex;align-items:center;gap:6px;margin-bottom:6px}
    .post-avatar{width:24px;height:24px;border-radius:50%;color:#fff;font-size:11px;font-weight:700;display:flex;align-items:center;justify-content:center;flex-shrink:0}
    .post-author-name{font-size:11px;color:var(--text-muted)}
    .post-time{font-size:10px;color:#aaa;margin-left:auto}
    .post-title{font-size:13px;font-weight:700;color:var(--text);margin-bottom:4px;line-height:1.4}
    .post-body{font-size:12px;color:var(--text-muted);line-height:1.6;display:-webkit-box;-webkit-line-clamp:3;-webkit-box-orient:vertical;overflow:hidden}
    .post-file-badge{display:inline-flex;align-items:center;gap:4px;margin-top:8px;background:#e8f4ea;color:var(--primary);font-size:10px;font-weight:600;padding:3px 8px;border-radius:6px}

    .fab{position:fixed;bottom:32px;right:32px;width:56px;height:56px;border-radius:50%;background:var(--accent2);color:#fff;font-size:28px;border:none;cursor:pointer;box-shadow:0 4px 20px rgba(231,111,81,0.4);display:flex;align-items:center;justify-content:center;transition:all 0.2s;z-index:200}
    .fab:hover{background:var(--accent);transform:scale(1.08)}

    .modal-overlay{display:none;position:fixed;inset:0;background:rgba(0,0,0,0.45);z-index:300;align-items:center;justify-content:center}
    .modal-overlay.open{display:flex}
    .modal{background:var(--surface);border-radius:var(--radius);padding:32px;width:min(580px,95vw);max-height:90vh;overflow-y:auto;box-shadow:0 20px 60px rgba(0,0,0,0.25);animation:modalIn 0.22s ease}
    @keyframes modalIn{from{opacity:0;transform:translateY(24px) scale(0.97)}to{opacity:1;transform:none}}
    .modal-title{font-family:'Gowun Batang',serif;font-size:20px;font-weight:700;color:var(--primary-dark);margin-bottom:20px}
    .form-group{margin-bottom:14px}
    .form-label{display:block;font-size:12px;font-weight:600;color:var(--text-muted);margin-bottom:5px}
    .form-input,.form-select,.form-textarea{width:100%;padding:10px 12px;border:1.5px solid var(--border);border-radius:8px;font-family:'Noto Sans KR',sans-serif;font-size:13px;color:var(--text);background:var(--surface);transition:border-color 0.18s;outline:none}
    .form-input:focus,.form-select:focus,.form-textarea:focus{border-color:var(--primary-light)}
    .form-textarea{resize:vertical;min-height:100px}
    .modal-actions{display:flex;gap:10px;margin-top:20px;justify-content:flex-end}

    /* ─── 파일 업로드 영역 ─── */
    .upload-zone{border:2px dashed var(--border);border-radius:12px;padding:24px 16px;text-align:center;cursor:pointer;transition:all 0.2s;position:relative;background:var(--surface)}
    .upload-zone:hover,.upload-zone.dragover{border-color:var(--primary-light);background:#f0faf3}
    .upload-zone input[type=file]{position:absolute;inset:0;opacity:0;cursor:pointer;width:100%;height:100%}
    .upload-icon{font-size:32px;margin-bottom:8px}
    .upload-label{font-size:13px;font-weight:600;color:var(--primary);margin-bottom:4px}
    .upload-hint{font-size:11px;color:var(--text-muted)}

    /* 업로드 진행 표시 */
    .upload-progress-wrap{display:none;margin-top:12px;background:#e8f4ea;border-radius:10px;padding:12px 14px;border:1px solid #b7e4c7}
    .upload-progress-wrap.show{display:block}
    .upload-progress-info{display:flex;align-items:center;gap:8px;margin-bottom:8px;font-size:12px;color:var(--primary);font-weight:600}
    .upload-progress-bar-bg{background:#c8e6d0;border-radius:6px;height:6px;overflow:hidden}
    .upload-progress-bar{background:var(--primary-light);height:100%;border-radius:6px;transition:width 0.3s;width:0%}
    .upload-progress-pct{font-size:11px;color:var(--text-muted);margin-top:4px;text-align:right}

    /* 첨부된 파일 미리보기 */
    .attached-file{display:none;margin-top:10px;background:#e8f4ea;border-radius:8px;padding:10px 14px;font-size:12px;color:var(--primary);border:1px solid #b7e4c7;align-items:center;gap:8px}
    .attached-file.show{display:flex}
    .attached-file-name{flex:1;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;font-weight:500}
    .attached-file-size{font-size:11px;color:var(--text-muted);white-space:nowrap}
    .attached-file-remove{cursor:pointer;color:var(--danger);font-size:18px;flex-shrink:0;line-height:1;background:none;border:none;padding:0}

    /* 기존 파일 정보 */
    .existing-file-info{margin-top:8px;font-size:12px;color:var(--text-muted);padding:8px 12px;background:#fff8f0;border-radius:8px;border:1px solid #f4a261}

    /* 구글 로그인 필요 안내 */
    .gauth-required-notice{background:#fff8f0;border:1.5px solid var(--accent);border-radius:10px;padding:12px 14px;font-size:12px;color:#c05c00;margin-top:8px;display:flex;align-items:center;gap:8px}
    .gauth-required-notice button{margin-left:auto;padding:5px 12px;background:var(--accent);color:#fff;border:none;border-radius:6px;font-size:11px;font-weight:700;cursor:pointer;white-space:nowrap}

    /* VIEW MODAL */
    .view-meta{display:flex;align-items:center;gap:8px;margin-bottom:16px;flex-wrap:wrap}
    .view-dept-tag{color:#fff;font-size:11px;font-weight:700;padding:3px 10px;border-radius:20px}
    .view-author{font-size:12px;color:var(--text-muted)}
    .view-time{font-size:11px;color:#aaa;margin-left:auto}
    .view-title{font-family:'Gowun Batang',serif;font-size:22px;font-weight:700;color:var(--primary-dark);margin-bottom:14px;line-height:1.4}
    .view-body{font-size:14px;color:var(--text);line-height:1.8;white-space:pre-wrap;margin-bottom:16px;min-height:20px}
    .view-file-link{display:inline-flex;align-items:center;gap:8px;background:#e8f4ea;color:var(--primary);padding:10px 16px;border-radius:8px;font-size:13px;font-weight:600;text-decoration:none;border:1px solid var(--primary-light);margin-bottom:20px;transition:all 0.18s}
    .view-file-link:hover{background:#d8eedb}
    .view-file-download{display:inline-flex;align-items:center;gap:8px;background:var(--primary);color:#fff;padding:10px 16px;border-radius:8px;font-size:13px;font-weight:600;text-decoration:none;border:none;margin-bottom:20px;margin-left:8px;cursor:pointer;transition:all 0.18s}
    .view-file-download:hover{background:var(--primary-dark)}
    .view-actions{display:flex;gap:8px;padding-top:16px;border-top:1px solid var(--border);flex-wrap:wrap}

    /* CONFIRM */
    .confirm-modal{background:var(--surface);border-radius:var(--radius);padding:32px;width:min(360px,90vw);box-shadow:0 20px 60px rgba(0,0,0,0.25);animation:modalIn 0.22s ease;text-align:center}
    .confirm-icon{font-size:44px;margin-bottom:12px}
    .confirm-title{font-size:17px;font-weight:700;color:var(--text);margin-bottom:8px}
    .confirm-desc{font-size:13px;color:var(--text-muted);margin-bottom:24px;line-height:1.6}
    .confirm-actions{display:flex;gap:10px;justify-content:center}

    .search-input{background:rgba(255,255,255,0.12);border:1.5px solid rgba(255,255,255,0.2);border-radius:8px;padding:6px 14px;color:#fff;font-family:'Noto Sans KR',sans-serif;font-size:13px;width:200px;outline:none}
    .search-input::placeholder{color:rgba(255,255,255,0.5)}
    .search-input:focus{border-color:var(--primary-light);background:rgba(255,255,255,0.18)}

    .empty-state{text-align:center;padding:32px 16px;color:var(--text-muted)}
    .empty-state-icon{font-size:36px;margin-bottom:8px}
    .empty-state-text{font-size:13px}

    .toast{position:fixed;bottom:32px;left:50%;transform:translateX(-50%) translateY(60px);background:var(--primary-dark);color:#fff;padding:12px 24px;border-radius:30px;font-size:13px;font-weight:500;transition:transform 0.3s,opacity 0.3s;opacity:0;z-index:999;white-space:nowrap;max-width:90vw;text-align:center}
    .toast.show{transform:translateX(-50%) translateY(0);opacity:1}

    .loading-spinner{display:flex;align-items:center;justify-content:center;padding:40px;color:var(--text-muted);gap:10px}
    .spinner{width:20px;height:20px;border:2px solid var(--border);border-top-color:var(--primary-light);border-radius:50%;animation:spin 0.7s linear infinite}
    @keyframes spin{to{transform:rotate(360deg)}}

    @media(max-width:640px){
      header{padding:0 16px}.tabs-bar{padding:0 12px}
      .board-wrapper{padding:16px 12px 80px}.columns-grid{grid-template-columns:1fr}
      .search-input{width:130px}.header-school{font-size:13px}
    }
  </style>
</head>
<body>

<header>
  <div class="header-left">
    <div class="school-logo">경</div>
    <div>
      <div class="header-school">광주경신여자고등학교</div>
      <div class="header-sub">2026학년도 행정자료 공유 플랫폼</div>
    </div>
  </div>
  <div class="header-actions">
    <input class="search-input" id="searchInput" placeholder="🔍 검색..." oninput="filterPosts()">
    <!-- 구글 로그인 상태 버튼 -->
    <div class="gauth-status" id="gauthStatus" onclick="handleAuthClick()">
      <div class="gauth-dot" id="gauthDot"></div>
      <span class="gauth-label" id="gauthLabel">구글 연결</span>
    </div>
    <button class="btn btn-primary" onclick="openPostModal()">＋ 게시물</button>
  </div>
</header>

<div class="tabs-bar" id="tabsBar">
  <button class="tab-btn active" data-dept="all" onclick="filterDept('all',this)">
    전체 <span class="tab-count" id="count-all">0</span>
  </button>
</div>

<div class="board-wrapper">
  <div class="board-header">
    <div class="board-title-row">
      <span class="dept-badge">2026</span>
      <span class="dept-label" id="currentDeptLabel">전체 부서</span>
    </div>
    <span id="totalCountLabel" style="font-size:12px;color:var(--text-muted)"></span>
  </div>
  <div class="columns-grid" id="columnsGrid">
    <div class="loading-spinner"><div class="spinner"></div> 불러오는 중...</div>
  </div>
</div>

<button class="fab" onclick="openPostModal()">＋</button>

<!-- NEW / EDIT MODAL -->
<div class="modal-overlay" id="postModal">
  <div class="modal">
    <div class="modal-title" id="postModalTitle">📋 새 게시물 작성</div>
    <input type="hidden" id="editPostId">
    <div class="form-group">
      <label class="form-label">부서 선택 *</label>
      <select class="form-select" id="postDept">
        <option value="">-- 부서 선택 --</option>
        <option>교무기획부</option><option>교육연구부</option><option>학생생활안전부</option>
        <option>교육과정부</option><option>미래교육기획부</option><option>창의체험활동부</option>
        <option>교육정보부</option>
      </select>
    </div>
    <div class="form-group">
      <label class="form-label">작성자 이름 *</label>
      <input class="form-input" id="postAuthor" placeholder="예: 홍길동">
    </div>
    <div class="form-group">
      <label class="form-label">제목 *</label>
      <input class="form-input" id="postTitle" placeholder="제목을 입력하세요">
    </div>
    <div class="form-group">
      <label class="form-label">내용</label>
      <textarea class="form-textarea" id="postBody" placeholder="내용을 입력하세요..."></textarea>
    </div>

    <!-- ─── 파일 업로드 섹션 ─── -->
    <div class="form-group">
      <label class="form-label">📁 파일 첨부 (구글 드라이브 자동 업로드)</label>

      <!-- 구글 로그인 안내 (비로그인 시) -->
      <div class="gauth-required-notice" id="gauthNotice" style="display:none">
        ⚠️ 파일을 업로드하려면 구글 계정 연결이 필요합니다.
        <button onclick="handleAuthClick()">구글 연결하기</button>
      </div>

      <!-- 드래그앤드롭 업로드 존 -->
      <div class="upload-zone" id="uploadZone">
        <input type="file" id="fileInput" onchange="handleFileSelect(this.files[0])">
        <div class="upload-icon">☁️</div>
        <div class="upload-label">클릭하거나 파일을 여기로 드래그하세요</div>
        <div class="upload-hint">선택한 부서 폴더에 자동으로 업로드됩니다</div>
      </div>

      <!-- 업로드 진행 바 -->
      <div class="upload-progress-wrap" id="uploadProgressWrap">
        <div class="upload-progress-info">
          <span>📤</span>
          <span id="uploadProgressFileName">파일 업로드 중...</span>
        </div>
        <div class="upload-progress-bar-bg">
          <div class="upload-progress-bar" id="uploadProgressBar"></div>
        </div>
        <div class="upload-progress-pct" id="uploadProgressPct">0%</div>
      </div>

      <!-- 첨부된 파일 표시 -->
      <div class="attached-file" id="attachedFile">
        <span>📎</span>
        <span class="attached-file-name" id="attachedFileName"></span>
        <span class="attached-file-size" id="attachedFileSize"></span>
        <button class="attached-file-remove" onclick="removeAttachedFile()">✕</button>
      </div>

      <!-- 수정 시 기존 파일 정보 -->
      <div class="existing-file-info" id="existingFileInfo" style="display:none">
        📎 현재 첨부파일: <a id="existingFileLink" href="#" target="_blank" style="color:var(--primary);font-weight:600"></a>
        <span style="color:#aaa"> — 새 파일 선택 시 교체됩니다</span>
      </div>
    </div>

    <div class="modal-actions">
      <button class="btn btn-cancel" onclick="closePostModal()">취소</button>
      <button class="btn btn-primary" id="postSubmitBtn" onclick="submitPost()">게시하기</button>
    </div>
  </div>
</div>

<!-- VIEW MODAL -->
<div class="modal-overlay" id="viewModal">
  <div class="modal">
    <div id="viewContent"></div>
    <div class="view-actions">
      <button class="btn btn-edit" onclick="openEditFromView()">✏️ 수정하기</button>
      <button class="btn btn-danger" onclick="confirmDelete()">🗑️ 삭제하기</button>
      <button class="btn btn-cancel" style="margin-left:auto" onclick="closeViewModal()">닫기</button>
    </div>
  </div>
</div>

<!-- CONFIRM DELETE -->
<div class="modal-overlay" id="confirmModal">
